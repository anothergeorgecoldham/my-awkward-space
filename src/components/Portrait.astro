---
const { eager = false, caption = false } = Astro.props;
---
<figure class="portrait-frame">
  <img class="portrait" src="/assets/images/george-coldham-1200.webp" srcset="/assets/images/george-coldham-640.webp 640w, /assets/images/george-coldham-1200.webp 1200w" sizes="(max-width: 700px) 88vw, 42vw" width="1200" height="1200" alt="George Coldham smiling outdoors, wearing glasses and a broad-brimmed hat" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" />
  {caption && <figcaption><span>George Coldham</span><span>Perth, Australia</span></figcaption>}
</figure>
