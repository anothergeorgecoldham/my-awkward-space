---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getAllPosts } from "../../utils/getPosts";
const posts = getAllPosts();
---
<Layout title="Writing | George Coldham" description="George Coldham on security, identity, AI and the humans behind the technology.">
<header class="page-heading"><p class="eyebrow accent-warm">Notes from the real world</p><h1>Writing.</h1><p class="lead">Security, identity, AI, and the messy reality of making them work.</p></header>
<section class="post-grid" aria-label="All articles">{posts.map(post => <PostCard post={post} />)}</section>
</Layout>
