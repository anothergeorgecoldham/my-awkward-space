---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config/content";
import { formatDate } from "../../utils/date";
export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob("../../content/blog/*.md", { eager: true }));
  return posts.map((post: any) => ({ params: { slug: post.frontmatter.slug || post.file.split("/").pop().replace(".md", "") }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = post;
const f = post.frontmatter;
---
<Layout title={`${f.title} - ${siteConfig.name}`} description={f.description || ""} customSEO>
  <Fragment slot="head">
    {f.canonicalURL && <link rel="canonical" href={f.canonicalURL} />}
    <meta property="og:title" content={f.ogTitle || f.title} />
    <meta property="og:description" content={f.ogDescription || f.description || ""} />
    <meta property="og:type" content={f.ogType || "article"} />
    {f.ogImage && <meta property="og:image" content={f.ogImage} />}
    {f.canonicalURL && <meta property="og:url" content={f.canonicalURL} />}
    <meta name="twitter:card" content={f.twitterCard || "summary_large_image"} />
    <meta name="twitter:title" content={f.twitterTitle || f.ogTitle || f.title} />
    <meta name="twitter:description" content={f.twitterDescription || f.ogDescription || f.description || ""} />
    {(f.twitterImage || f.ogImage) && <meta name="twitter:image" content={f.twitterImage || f.ogImage} />}
    {f.keywords && <meta name="keywords" content={f.keywords.join(", ")} />}
  </Fragment>
  <article class="article-shell">
    <header class="article-header"><a class="text-link" href="/blog/">← All writing</a><h1>{f.title}</h1><p class="eyebrow">Published <time datetime={String(f.date).slice(0,10)}>{formatDate(f.date)}</time>{f.readTime && <> · {f.readTime}</>}</p></header>
    <div class="article-body"><Content /></div>
  </article>
</Layout>
