---
import Layout from "../layouts/Layout.astro";
import Portrait from "../components/Portrait.astro";
import { aboutContent } from "../config/content";
---
<Layout title={aboutContent.meta.title} description={aboutContent.meta.description}>
<header class="page-heading"><p class="eyebrow accent-warm">The person behind the posts</p><h1>{aboutContent.title}</h1></header>
<div class="about-intro split"><div><p class="lead">{aboutContent.description}</p><h2>Focus areas</h2><ul class="tags">{aboutContent.skills.map(skill => <li>{skill}</li>)}</ul></div><Portrait eager caption /></div>
<div class="section split">
  <section><h2>{aboutContent.experience.title}</h2><div class="stack">{aboutContent.experience.items.map(item => <article class="info-panel"><p class="eyebrow">{item.period}</p><h3>{item.position}</h3><p class="accent">{item.company}</p><p>{item.description}</p></article>)}</div></section>
  <aside class="stack"><section class="info-panel"><h2>{aboutContent.speaking.title}</h2><p>{aboutContent.speaking.description}</p><ul class="topic-list">{aboutContent.speaking.topics.map(topic => <li>{topic}</li>)}</ul><a class="text-link" href="/speaker/">Speaking information ↗</a></section><section class="info-panel"><h2>{aboutContent.connect.title}</h2><p>{aboutContent.connect.description} <a class="inline-link" href={aboutContent.connect.email.href}>{aboutContent.connect.email.text}</a></p></section></aside>
</div>
</Layout>
