---
import Layout from "../layouts/Layout.astro";
import Portrait from "../components/Portrait.astro";
import { aboutContent, homeContent } from "../config/content";
// Keep Sessionize as the source of speaker biography and session descriptions.
const response = await fetch("https://sessionize.com/api/speaker/json/d4m9fc7xg4", { signal: AbortSignal.timeout(15000) });
if (!response.ok) throw new Error(`Sessionize returned ${response.status}`);
const data = await response.json();
const speaker = data.speaker || {};
const talks = data.sessions || [];
---
<Layout title="Speaking | George Coldham" description="Speaker biography, session topics and resources for event organisers booking George Coldham.">
<header class="page-heading"><p class="eyebrow accent-warm">For conference organisers and event planners</p><h1>Ideas worth taking<br /><em>back to work.</em></h1><p class="lead">Speaker biography, talk topics, and ways to get in touch.</p><a class="button primary" href={aboutContent.connect.email.href}>Enquire about speaking ↗</a></header>
<div class="split">
<section class="info-panel"><h2>Biography</h2>{speaker.tagline && <p class="accent">{speaker.tagline}</p>}<p class="speaker-bio">{speaker.bio || aboutContent.description}</p></section>
<aside><Portrait eager caption /><div class="info-panel stack"><h2>Quick facts</h2><dl class="fact-list"><dt>Role</dt><dd>Cloud Solution Architect</dd><dt>Company</dt><dd>Microsoft ANZ</dd><dt>Location</dt><dd>Perth, Australia</dd><dt>Focus</dt><dd>Security &amp; AI</dd></dl></div></aside>
</div>
{homeContent.upcomingTalk && <section class="section"><p class="eyebrow accent-warm">Next on stage</p><h2>{homeContent.upcomingTalk.conference}</h2><p>{homeContent.upcomingTalk.date} · {homeContent.upcomingTalk.location}</p><a class="text-link" href={homeContent.upcomingTalk.url} target="_blank" rel="noopener noreferrer">{homeContent.upcomingTalk.title} ↗</a></section>}
{talks.length > 0 && <section class="section"><h2>Speaking topics</h2><div class="stack">{talks.map(talk => <article class="info-panel"><h3>{talk.title}</h3>{talk.description && <p class="speaker-bio">{talk.description}</p>}</article>)}</div></section>}
<section class="info-panel section"><h2>Let's talk about your event.</h2><p>For speaking enquiries: <a class="inline-link" href={aboutContent.connect.email.href}>{aboutContent.connect.email.text}</a></p></section>
</Layout>
