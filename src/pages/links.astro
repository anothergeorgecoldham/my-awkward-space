---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/content";
import SocialIcon from "../components/SocialIcon.astro";

 const links = [
   {
     name: "LinkedIn",
     url: "https://www.linkedin.com/in/georgecoldham/",
     icon: "linkedin",
   },
   {
     name: "GitHub",
     url: "https://github.com/anothergeorgecoldham",
     icon: "github",
   },
   {
     name: "YouTube",
     url: "https://youtube.com/@georgecoldham",
     icon: "youtube",
   },
   {
     name: "X (Twitter)",
     url: "https://x.com/georgecoldham",
     icon: "x",
   },
   {
     name: "Threads",
     url: "https://threads.net/@gcoldham",
     icon: "threads",
   },
   {
     name: "Bluesky",
     url: "https://bsky.app/profile/george.coldham.com.au",
     icon: "bluesky",
   },
   {
     name: "Instagram",
     url: "https://www.instagram.com/gcoldham/",
     icon: "instagram",
   },
   {
     name: "TikTok",
     url: "http://tiktok.com/georgecoldham",
     icon: "tiktok",
   },
 ];
---
<Layout title={`Links - ${siteConfig.name}`} description="Where to find George Coldham across the web.">
<div class="link-page"><header class="page-heading"><p class="eyebrow accent-warm">Keep in touch</p><h1>Let's connect.</h1><p class="lead">You probably followed a QR code to get here. These are the places to find me.</p></header>
<div class="social-links">{links.map(link => <a class="social-link" href={link.url} target="_blank" rel="noopener noreferrer"><SocialIcon name={link.icon} class="social-icon" /><h2>{link.name}</h2><span class="link-arrow" aria-hidden="true">↗</span></a>)}</div>
</div>
</Layout>
