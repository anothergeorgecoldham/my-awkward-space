---
import Layout from "../layouts/Layout.astro";
import Portrait from "../components/Portrait.astro";
import PostCard from "../components/PostCard.astro";
import { siteConfig, homeContent } from "../config/content";
import { getAllPosts } from "../utils/getPosts";
const posts = getAllPosts();
const talk = homeContent.upcomingTalk;
const date = talk ? new Date(talk.date) : null;
---
<Layout title={siteConfig.title} description={siteConfig.description}>
<section class="hero">
  <div class="hero-copy"><p class="eyebrow hero-eyebrow"><span class="status-dot" aria-hidden="true"></span>George Coldham · Perth, Australia</p><h1>Security, AI,<br />and the humans<br /><em>in between.</em></h1><p class="hero-intro">{homeContent.description}</p><div class="actions"><a class="button primary" href="/blog/">Explore the writing <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">A little about me</a></div></div>
  <div class="hero-portrait"><Portrait eager caption /><span class="portrait-note" aria-hidden="true">Less jargon.<br />More understanding.</span></div>
</section>
{talk && date && <a class="event-feature interactive" href={talk.url} target="_blank" rel="noopener noreferrer"><div class="event-date"><strong>{String(date.getDate()).padStart(2,"0")}</strong><span>{date.toLocaleString("en-AU",{month:"short"})} {date.getFullYear()}</span></div><div><p class="eyebrow">Next on stage · {talk.conference}</p><h2>{talk.title}</h2><p>{talk.location} · View the session</p></div><span class="round-arrow" aria-hidden="true">↗</span></a>}
<section class="section"><div class="section-heading"><div><p class="eyebrow accent-warm">Notes from the real world</p><h2>A few things worth sharing.</h2></div><a class="text-link" href="/blog/">All writing ↗</a></div><div class="featured-writing">{posts[0] && <PostCard post={posts[0]} featured />}<div class="selected-posts">{posts.slice(1,3).map(post => <PostCard post={post} />)}</div></div></section>
</Layout>
